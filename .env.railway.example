# Railway injects PORT automatically.

# Mount a Railway volume at /data before enabling this value.
CACHE_DB=/data/cache.db

# The frontend and API share one origin in production.
ALLOWED_ORIGINS=

# Protect the upstream chess APIs and cap accidental traffic.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
STATIC_RATE_LIMIT_PER_MINUTE=60
STATIC_RATE_LIMIT_BURST=30
